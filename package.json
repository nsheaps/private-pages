{
  "name": "private-pages",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nsheaps/private-pages.git"
  },
  "keywords": [
    "github-pages",
    "private-repos",
    "static-site",
    "isomorphic-git",
    "opfs",
    "service-worker"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "description": "Client-only GitHub Pages for private repos — authenticate via GitHub OAuth, clone with isomorphic-git into OPFS, render static sites in the browser",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:sw",
    "build:sw": "vite build --config vite.config.sw.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "validate": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "isomorphic-git": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
